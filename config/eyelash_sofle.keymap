#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include "extra_keys.h"

#define DEF 0
#define FUN 1

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        hld_clk: hld_clk {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mkp>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
            &kp ESC      &kp N1       &kp N2       &kp N3        &kp N4           &kp N5        &kp UP                  &kp N6        &kp N7           &kp N8          &kp N9          &kp N0          &kp BSLH
            &kp TAB      &kp Q        &kp W        &kp E         &kp R            &kp T         &kp DOWN                &kp Y         &kp U            &kp I           &kp O           &kp P           &kp LBKT
            &kp LSHIFT   &kp A        &kp S        &kp D         &kp F            &kp G         &kp LEFT                &kp H         &kp J            &kp K           &kp L           &kp SEMI        &kp SQT 
            &kp LCTRL    &kp Z        &kp X        &kp C         &kp V            &kp B         &kp RIGHT               &kp N         &kp M            &kp COMMA       &kp DOT         &kp FSLH        &kp RBKT
&kp C_MUTE               &kp LGUI     &mo FUN      &kp LALT      &kp NEXT_LAYOUT  &kp SPACE     &hld_clk RCLK LCLK      &kp ENTER     &kp BSPC         &kp DEL         &kp MINUS       &kp PLUS    
            >;

          sensor-bindings = <&rsr_vol>;
        };
        
        functional {
            bindings = <
            &kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &trans        &kp F6            &kp F7           &kp F8     &kp F9    &kp F10     &kp TILDE
            &trans      &trans           &trans          &trans           &trans           &kp F11            &trans        &kp F12           &trans           &trans     &trans    &trans      &trans
            &trans      &kp HOME         &trans          &trans           &trans           &trans             &trans        &trans            &trans           &trans     &kp END   &trans      &trans
            &trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &trans        &rgb_ug RGB_BRI   &rgb_ug RGB_BRD  &trans     &trans    &trans      &trans
&kp C_MUTE              &trans           &trans          &trans           &trans           &trans             &trans        &trans            &trans           &trans     &trans    &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
